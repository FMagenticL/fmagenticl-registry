{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FMagenticL Resolution Lookup Response",
  "type": "object",
  "required": ["status", "confidence", "trust_score"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["RESOLVED", "NOT_FOUND", "RATE_LIMITED"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "trust_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "dispute_count": { "type": "integer" },
    "grievance_count": { "type": "integer" },
    "submitted_by": { "type": "string" },
    "verification_tier": { "type": "string" },
    "is_quarantined": { "type": "boolean" },
    "foundational": { "type": "boolean" },
    "patch_type": {
      "type": "string",
      "enum": [
        "application/json-patch+json",
        "cli-override",
        "file-op",
        "retry-strategy",
        "mcp-substitution"
      ]
    },
    "target_file": { "type": "string" },
    "json_patch": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["op", "path"],
        "properties": {
          "op": { "type": "string", "enum": ["test", "add", "remove", "replace", "move", "copy"] },
          "path": { "type": "string" },
          "value": {},
          "from": { "type": "string" }
        }
      }
    },
    "fallback_cli": { "type": "string" },
    "file_ops": { "type": "array" },
    "strategy": { "type": "string" },
    "config_patch": { "type": "object" },
    "mcp_uri": { "type": "string" },
    "action": { "type": "string" },
    "key_path": { "type": "string" }
  }
}
