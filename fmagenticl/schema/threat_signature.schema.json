{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fmagenticl-registry.pages.dev/schema/threat_signature.schema.json",
  "title": "FMagenticL v3.0 Defensive Threat Signature",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "fingerprint",
    "confidence_tier",
    "threat_category",
    "severity",
    "title",
    "summary",
    "observable",
    "mitigation_steps",
    "taxonomy",
    "references"
  ],
  "properties": {
    "schema_version": { "const": "3.0" },
    "id": { "type": "string", "pattern": "^SIG-2026-[0-9]{4}$" },
    "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "confidence_tier": {
      "type": "string",
      "enum": ["CONFIRMED_SIGNATURE", "BEHAVIORAL_INDICATOR"]
    },
    "threat_category": {
      "type": "string",
      "enum": [
        "OFFENSIVE_AGENT_HARNESS",
        "MCP_AND_WORKSPACE_HIJACK",
        "AUTONOMOUS_BEHAVIORAL_IOC",
        "EXPLOITED_AI_INFRASTRUCTURE"
      ]
    },
    "severity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM"] },
    "title": { "type": "string", "minLength": 8, "maxLength": 160 },
    "summary": { "type": "string", "minLength": 20, "maxLength": 280 },
    "observable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "observable_type",
        "http_paths",
        "http_headers",
        "user_agents",
        "ports",
        "file_paths",
        "config_keys",
        "process_or_container_indicators",
        "cloud_api_sequence",
        "window_seconds",
        "threshold_count",
        "affected_packages",
        "detection_regex"
      ],
      "properties": {
        "surface": {
          "type": "string",
          "enum": [
            "workspace_config",
            "mcp_transport",
            "http_gateway",
            "cloud_control_plane",
            "llm_api",
            "container_and_host",
            "network_and_host"
          ]
        },
        "observable_type": { "type": "string", "minLength": 3, "maxLength": 64 },
        "http_paths": { "type": "array", "items": { "type": "string" } },
        "http_headers": { "type": "array", "items": { "type": "string" } },
        "user_agents": { "type": "array", "items": { "type": "string" } },
        "ports": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 65535 } },
        "file_paths": { "type": "array", "items": { "type": "string" } },
        "config_keys": { "type": "array", "items": { "type": "string" } },
        "process_or_container_indicators": { "type": "array", "items": { "type": "string" } },
        "cloud_api_sequence": { "type": "array", "items": { "type": "string" } },
        "window_seconds": { "type": ["integer", "null"], "minimum": 1 },
        "threshold_count": { "type": ["integer", "null"], "minimum": 1 },
        "affected_packages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ecosystem", "name", "affected_range"],
            "properties": {
              "ecosystem": { "type": "string" },
              "name": { "type": "string" },
              "affected_range": { "type": "string" }
            }
          }
        },
        "detection_regex": { "type": ["string", "null"] }
      }
    },
    "mitigation_steps": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 10, "maxLength": 240 }
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "advisory_ids",
        "cve_ids",
        "ghsa_ids",
        "cwe_ids",
        "mitre_attack_ids",
        "mitre_atlas_ids",
        "owasp_tags"
      ],
      "properties": {
        "advisory_ids": { "type": "array", "items": { "type": "string" } },
        "cve_ids": { "type": "array", "items": { "type": "string", "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$" } },
        "ghsa_ids": { "type": "array", "items": { "type": "string", "pattern": "^GHSA-[a-z0-9]{4}-[a-z0-9]{4}-[a-z0-9]{4}$" } },
        "cwe_ids": { "type": "array", "items": { "type": "string", "pattern": "^CWE-[0-9]+$" } },
        "mitre_attack_ids": { "type": "array", "items": { "type": "string" } },
        "mitre_atlas_ids": { "type": "array", "items": { "type": "string" } },
        "owasp_tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_name", "reference_id", "url", "source_type", "license_or_terms", "note"],
        "properties": {
          "source_name": { "type": "string", "minLength": 2 },
          "reference_id": { "type": "string", "minLength": 2 },
          "url": { "type": "string", "pattern": "^https://" },
          "source_type": {
            "type": "string",
            "enum": ["government_advisory", "vendor_research", "open_advisory", "academic_paper", "specification"]
          },
          "license_or_terms": { "type": "string", "minLength": 2 },
          "note": { "type": "string", "minLength": 5 }
        }
      }
    },
    "manifest": { "type": "object" },
    "ed25519_sig": { "type": "string" }
  }
}
