      {
        "ecosystem": "PyPI",
        "name": "litellm",
        "affected_range": ">=1.81.16,<1.83.7"
      }
    ],
    "detection_regex": "(?i)Authorization\\s*:\\s*Bearer\\s+[^\\r\\n]*(?:'|--|UNION\\s+SELECT|OR\\s+1=1)"
  },
  "mitigation_steps": [
